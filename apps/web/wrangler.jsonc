{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // 静的アセットの出力先 (dist/client) はビルド時にアダプタが設定する
  "assets": {
    "binding": "ASSETS"
  },
  // workers.dev とプレビュー URL は Access を通らないので無効化する
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
  // カスタムドメインは infra/terraform/cloudflare で管理する（routes をここに書かない）
}
