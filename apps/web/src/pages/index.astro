---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site.config';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// TODO: 自分のスキルに書き換える
const skills = [
  { area: 'Infrastructure', items: ['Proxmox VE', 'Kubernetes (k3s)', 'Terraform', 'Ansible'] },
  { area: 'Cloud', items: ['Cloudflare Workers', 'Oracle Cloud', 'Google Cloud'] },
  { area: 'Observability', items: ['Prometheus', 'Grafana', 'Uptime Kuma'] },
  { area: 'Web', items: ['TypeScript', 'Astro'] },
];
---

<Base>
  <section class="hero">
    <p class="tag">{site.role}</p>
    <h1>{site.name}</h1>
    <p class="lead">{site.description}</p>
    <p class="muted">
      このサイトは Cloudflare Workers で動いています。自宅の Proxmox と無料のクラウドを組み合わせた構成は
      <a href="/architecture/">Architecture</a> にまとめています。
    </p>
  </section>

  <section>
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <p><a href="/projects/">すべて見る →</a></p>
  </section>

  <section>
    <h2>Skills</h2>
    <div class="grid">
      {
        skills.map((s) => (
          <div class="card">
            <h3>{s.area}</h3>
            <ul>
              {s.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 2rem 0 1rem;
  }
  h1 {
    margin: 0.5rem 0;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.2;
  }
  .lead {
    font-size: 1.15rem;
  }
  section + section {
    margin-top: 3rem;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  ul {
    margin: 0;
    padding-left: 1.2rem;
  }
</style>
