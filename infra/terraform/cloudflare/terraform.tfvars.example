# terraform.tfvars にコピーして値を埋める（terraform.tfvars は .gitignore 済み）
account_id = "your-account-id"
zone_id    = "your-zone-id"
zone_name  = "example.com"

homelab_services = {
  # "demo" = "http://192.168.1.50:8080"
}

# 公開前は自分だけが見られるようにする。公開するときは false
access_enabled        = true
access_allowed_emails = ["you@example.com"]
